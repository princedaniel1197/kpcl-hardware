      "tag": "U1_MW",
      "rules": {
        "range": {},
        "rate_of_change": {
          "max_per_second": 60
        },
        "frozen": {
          "window_seconds": 30,
          "tolerance": 0.001
        },
        "stale": {
          "max_seconds": 60
        }
      }
    },
