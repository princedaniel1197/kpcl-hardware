# Local environment — contains the dev database password.
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Collector store-and-forward buffer (Stage 3). Runtime state, never committed.
*.sqlite
*.sqlite3
buffer/

# Node / UI (Stage 12)
node_modules/
ui/dist/
ui/.vite/

# PlatformIO / Arduino (Stage 10)
.pio/
firmware/.pio/
# WiFi credentials. The repository is public; firmware/src/secrets.h.example is
# the template.
firmware/src/secrets.h

# FAT evidence captured at run time is committed deliberately, not swept up.
fat/evidence/tmp/

# macOS
.DS_Store

# Backups and exports are data, not source.
backups/
exports/

# ops/services.sh: service logs and process ids
/logs/
/.run/
