<?xml version="1.0" encoding="UTF-8"?>
<!--
  Karnataka SLDC generation recorder.

  This is a LaunchAgent: launchd starts it when the user logs in and restarts it
  if it exits. That survives a reboot provided the machine logs in again — set
  automatic login, or the recorder waits at the login window. For a recorder
  that runs before any login, this file belongs in /Library/LaunchDaemons with
  root ownership instead; that needs an administrator and is a deliberate
  choice, not a default.

  Generated by `make scraper-install`. __PLACEHOLDERS__ are substituted there.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.orianode.crpms.sldc-recorder</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>-m</string>
        <string>scraper</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__WORKDIR__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>CRPMS_DSN</key>
        <string>__DSN__</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <!-- Start at login and keep it running. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- Do not hammer the site if the process is crash-looping. -->
    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>__LOGDIR__/sldc-recorder.log</string>
    <key>StandardErrorPath</key>
    <string>__LOGDIR__/sldc-recorder.log</string>
</dict>
</plist>
