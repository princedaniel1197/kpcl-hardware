# CRPMS Demonstrator — local environment.
# `make up` copies this to .env if .env does not exist. .env is not committed.

# --- Archive (TimescaleDB, docker-compose.yml) ---
POSTGRES_USER=crpms
POSTGRES_PASSWORD=crpms
POSTGRES_DB=crpms
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Single source of truth for psycopg. Stages 2+ read this.
CRPMS_DSN=postgresql://crpms:crpms@localhost:5432/crpms

# --- Simulator (Stage 1) ---
# OPC UA endpoint the collector subscribes to, and the separate HTTP port used
# to force tag quality during a demo.
SIM_OPCUA_ENDPOINT=opc.tcp://0.0.0.0:4840/orianode/crpms/
SIM_CONTROL_PORT=8081

# --- API (Stage 12) ---
API_HOST=127.0.0.1
API_PORT=8000
